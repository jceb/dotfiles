#!/usr/bin/env -S nu --stdin
# Copyright 2026 - 2026, identinet GmbH. All rights reserved.
# SPDX-License-Identifier: MIT

use std/log

# Start a user space chroot with nix and disassemble it when the main program terminates;
# Add additional packages to the environment beforehand via: nix profile --store ~/.nix add 'nixpkgs#PKG'
# It's similar to https://github.com/containers/bubblewrap
def main [
  directory: string
  # Data directory that is mounted into the chroot
  --mount_point (-m): string = "/data"
  # Mount point for the data directory; if mount point is set to /, bind mount directories for dev, proc and nix will be created inside the data directory
  --packages (-p): string = ""
  # Comma-separated list of additional packages to be made available via nix, alongside nushell and coreutils
  --verbose (-v)
  # Verbose log output
  --preserve-env (-P): string = ""
  # Comma-separated list of variables to preserve in the new environment
] {
  if $verbose { $env.NU_LOG_LEVEL = "debug" }
  let root = mktemp -d -t user-chroot_XXXXXX
  log info $"Setting up chroot at: ($root)"
  def join-with-root-dir [--create (-c)]: string -> string { let dir = [$root $in] | path join; if $create {log debug $"Creating directory: ($dir)"; mkdir $dir}; $dir }
  log debug "Ensure nushell is installed and the local nix store exists"
  let _packages = $packages | split row "," | append [nushell coreutils] | where (is-not-empty) | each { $"nixpkgs#($in)" }
  let profile = "nix-profile" | join-with-root-dir
  let cmd = [nix profile add --profile $profile ...$_packages]
  log debug $"Executing: ($cmd | str join ' ')"
  run-external ...$cmd
  log info "Preparing filesystem"
  let _mnt = $mount_point | path relative-to  / | join-with-root-dir -c
  let _nix = "nix" | join-with-root-dir -c
  let _dev = "dev" | join-with-root-dir -c
  let _ssl = "etc/ssl" | join-with-root-dir -c
  let _tmp = "tmp" | join-with-root-dir -c
  let _proc = "proc" | join-with-root-dir -c
  let _hostname = "etc/hostname" | join-with-root-dir
  let _group = "etc/group" | join-with-root-dir
  let _passwd = "etc/passwd" | join-with-root-dir
  let _resolvconf = "etc/resolv.conf" | join-with-root-dir
  let _nuconfig = ".config/nushell" | join-with-root-dir
  sudo mount -o bind $directory $_mnt
  # sudo mount -o bind ~/.nix/nix $_nix
  sudo mount -o bind /nix $_nix
  sudo mount -o bind /dev $_dev
  sudo mount -o bind /etc/ssl $_ssl
  "user-chroot" | save $_hostname
  "root:x:0:" | save $_group
  "root:x:0:0:System administrator:/root:/bin/nu" | save $_passwd
  "nameserver 127.0.0.53" | save $_resolvconf
  chmod 1777 $_tmp
  sudo mount -t proc proc $_proc
  let profile_dirs = [bin sbin lib libexec include share]
  $profile_dirs | each {|dir|
    if ([$profile $dir] | path join | path exists) {
      ln -s ([/ ($profile | path basename) $dir] | path join) ($dir | join-with-root-dir)
    }
  }
  let unshare = (which unshare).0.path
  let envcmd = (which env).0.path
  let cmd = [$envcmd -i "PATH=/bin:/sbin"] | append ($preserve_env | split row "," | each {|e| $'($e)=($env | get -o $e | default "")'}) | append [$unshare -rmU -R $root -w $mount_point -- nu --no-config-file --no-history]
  log debug $"Executing: ($cmd | str join ' ')"
  run-external $cmd
  log info "Cleaning up filesystem"
  $profile_dirs | each {|dir|
    if ([$profile $dir] | path join | path exists) {
      rm ($dir | join-with-root-dir)
    }
  }
  rm -rpf $_tmp $_hostname $_group $_passwd $_resolvconf $_nuconfig
  sudo umount $_proc; rmdir $_proc
  sudo umount $_ssl; rmdir $_ssl
  sudo umount $_dev; rmdir $_dev
  sudo umount $_nix; rmdir $_nix
  sudo umount $_mnt; rmdir $_mnt
  rmdir ("etc" | join-with-root-dir)
  rm $profile
  glob $"($profile)-*-link" | each { rm $in }
  if ($root | path exists) { rmdir $root }
}
